# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/click_montagem
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/click_montagem_test

# Segurança e Sessão (Gere uma chave forte em produção)
SESSION_SECRET=troque_esta_chave_secreta_em_producao_click_montagem_2026
SESSION_NAME=cm.sid
SESSION_MAX_AGE_MS=86400000

# Google OAuth / OpenID Connect (deixe as três variáveis vazias para desabilitar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Local, após obter credenciais: GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Produção: HTTPS obrigatório; informe somente os IPs/sub-redes dos proxies confiáveis.
TRUST_PROXY=

# Recuperação de senha: o token é enviado somente por e-mail, nunca pela API.
# Local: APP_URL=http://localhost:3000. Produção: origem pública HTTPS.
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Opcional: Configuração para script de migração do MySQL legado
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=click_montagem
