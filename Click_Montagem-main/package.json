{
  "name": "click-montagem",
  "version": "2.0.0",
  "description": "Plataforma web que conecta clientes e profissionais de montagem de móveis (Node.js, Express, MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "migrate:mysql": "node scripts/migrate-mysql-to-mongo.js",
    "test": "node scripts/run-tests.js",
    "test:api": "node scripts/run-tests.js tests/api.test.js",
    "test:google": "node scripts/run-tests.js tests/google-auth.test.js",
    "test:e2e": "node scripts/run-tests.js --browser"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.64.1",
    "supertest": "^7.0.0"
  }
}
